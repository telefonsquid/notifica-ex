{
	"name": "notifica-ex",
	"private": true,
	"version": "0.4.2",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 55560",
		"build": "svelte-kit sync && node ./node_modules/vite/bin/vite.js build",
		"preview": "vite preview --port 55560",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "bun test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
