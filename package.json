		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/web-push": "^3.6.4",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
