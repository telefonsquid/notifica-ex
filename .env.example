PUBLIC_POCKETBASE_URL="http://localhost:8091"
INTERNAL_POCKETBASE_URL="http://127.0.0.1:8091" # Node tries IPv6 first for localhost and waits about 250 ms on every new connection
ORIGIN="http://localhost:55560"
POCKETBASE_SUPERUSER_EMAIL="<EMAIL_HERE>" # any address, created on first start of a fresh pocketbase
POCKETBASE_SUPERUSER_PASSWORD="<PASSWORD_HERE>" # at least 8 characters
SERVER_AUTH_SECRET="<SECRET_HERE>" # generate a secure secret key and put it here
SIGNING_SECRET="" # optional, signs the buttons in reminders, SERVER_AUTH_SECRET while empty | changing it breaks buttons already sent

# ntfy server reminders get published to, and the token of a user allowed to publish
NTFY_URL="http://127.0.0.1:8092"
NTFY_TOKEN="<NTFY_TOKEN_HERE>"
PUBLIC_NTFY_URL="http://localhost:8092"
NTFY_VERSION="v2.11.0"

# Optional PocketBase settings, force applied on every start. Omit lines to manage them in the PocketBase admin UI instead.
POCKETBASE_APP_NAME="Notifica Ex"
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USERNAME="<SMTP_USER_HERE>"
SMTP_PASSWORD="<SMTP_PASSWORD_HERE>"
SMTP_TLS="true"
SMTP_SENDER_NAME="Notifica Ex"
SMTP_SENDER_ADDRESS="<SENDER_ADDRESS_HERE>"

# Browser notifications, stay off while empty | bunx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=""
VAPID_PRIVATE_KEY=""
